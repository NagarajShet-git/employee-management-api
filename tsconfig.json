{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "sourceMap": true,

    "declaration": true,

    "removeComments": true,

    "noUnusedLocals": true,

    "noUnusedParameters": true,

    "noImplicitReturns": true
  },

  "include": [
    "src", "src/app.ts"  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}